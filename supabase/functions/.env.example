# Local secrets for `supabase functions serve --env-file supabase/functions/.env`
# Copy to supabase/functions/.env (gitignored) and fill in.
#
# Your own Anthropic key for local testing — Molly's key lives only in the
# hosted project's secrets (write-only; deployed functions read it there).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: cheap model for plumbing tests (auth -> gate -> quota -> prompt).
LLM_MODEL=claude-haiku-4-5-20251001

# Only needed when exercising email paths locally:
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
