{
  "name": "WaitlistEmail",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email address for launch updates"
    },
    "source": {
      "type": "string",
      "default": "landing_page",
      "description": "Where the email was captured"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or context (up to 1000 characters)"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}