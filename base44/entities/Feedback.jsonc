{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "FK to User"
    },
    "type": {
      "type": "string",
      "enum": [
        "bug",
        "feature_request",
        "general",
        "cancellation"
      ],
      "default": "general",
      "description": "Type of feedback. 'cancellation' = exit survey answer captured when a subscriber opens the billing portal to downgrade or cancel."
    },
    "subject": {
      "type": "string",
      "description": "Short summary of the feedback"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the issue or request. For cancellation surveys: optional user note plus the plan they were on."
    },
    "page_url": {
      "type": "string",
      "description": "The app page the user was on when submitting"
    },
    "screenshot_url": {
      "type": "string",
      "description": "Uploaded screenshot file URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewing",
        "resolved",
        "wont_fix"
      ],
      "default": "open"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes for the admin"
    }
  },
  "required": [
    "type",
    "subject",
    "description"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}