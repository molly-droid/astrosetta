{
  "name": "LLMUsageLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "FK to User"
    },
    "date_key": {
      "type": "string",
      "description": "YYYY-MM-DD in UTC"
    },
    "call_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of LLM calls made today"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or context (up to 1000 characters)"
    }
  },
  "required": [
    "user_id",
    "date_key"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}