{
  "name": "Chart",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "FK to User"
    },
    "raw_data": {
      "type": "object",
      "description": "Full API response stored verbatim"
    },
    "placement_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extracted placement keys for curriculum"
    },
    "ascendant_sign": {
      "type": "string"
    },
    "sun_sign": {
      "type": "string"
    },
    "moon_sign": {
      "type": "string"
    },
    "calculated_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or context (up to 1000 characters)"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}